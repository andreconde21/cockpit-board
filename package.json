{
  "name": "cockpit-board",
  "version": "1.3.1",
  "description": "Dynamic Kanban board from frontmatter properties with calendar views, timers, and recurring tasks.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && cp main.js styles.css manifest.json \"$HOME/Dropbox/Obsidian/Cockpit/.obsidian/plugins/cockpit-board/\"",
    "lint": "npx eslint src/"
  },
  "keywords": [
    "obsidian",
    "kanban",
    "board",
    "calendar",
    "tasks"
  ],
  "author": "Outsmartis",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^16.11.6",
    "@typescript-eslint/parser": "8.70.1",
    "esbuild": "0.17.3",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
